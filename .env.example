SITE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI Gateway uses Vercel OIDC automatically in production.
# Set AI_GATEWAY_API_KEY only for local or non-Vercel environments.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-nano
AI_GATEWAY_FALLBACK_MODEL=anthropic/claude-haiku-4.5
# Equipment search: Supabase first, then capped Google Search research.
# Gemini 3.5 search requires billing. No automatic paid retries.
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared across all companies; 0 disables web search. Maximum 20 per day.
GEMINI_DAILY_CAP=20
# Optional: receives privacy-scrubbed operational error events.
ERROR_WEBHOOK_URL=
# Required only for the protected synthetic quote check.
SYNTHETIC_CHECK_TOKEN=
